# Copy this file to keystore.properties (which is gitignored). Use the exact
# same private certificate and values configured for HYDRA-UMC-ANDROID-CONTROL
# or Wear OS Data Layer will reject cross-device messages.
hydraUmcReleaseStoreFile=C:/secure-path/hydra-umc-release.jks
hydraUmcReleaseStorePassword=REPLACE_LOCALLY
hydraUmcReleaseKeyAlias=REPLACE_LOCALLY
hydraUmcReleaseKeyPassword=REPLACE_LOCALLY
