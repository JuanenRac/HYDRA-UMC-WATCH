<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declares this app targets watch hardware specifically - without it
         the Play Store would also offer it to phones/tablets, which have
         no use for a wrist safety dashboard. -->
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Requested only after an explicit operator tap on Speak to HYDRA-UMC. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HydraUmcWatch">

        <!-- Runs standalone on the watch (no paired-phone companion app
             required to launch it) - the safety dashboard/E-STOP has to
             work even if the operator's phone is out of Bluetooth range. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.HydraUmcWatch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Private phone relay channel. Google Play services invokes this
             only for an APK with the same application ID and signature. -->
        <service
            android:name=".transport.WatchRelayListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/hydra-umc/" />
            </intent-filter>
        </service>
    </application>
</manifest>
